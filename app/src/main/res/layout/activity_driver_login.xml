<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Login"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/driverEmailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driver email"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:autofillHints="emailAddress"/>



        <EditText
            android:id="@+id/driverPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:autofillHints="password"
            android:layout_marginTop="12dp"/>

        <CheckBox
            android:id="@+id/showPasswordCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show password"
            android:layout_gravity="start"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/driverLoginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#17365D"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/driverLoginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#52657A"
            android:textSize="14sp"/>

    </LinearLayout>

</ScrollView>
