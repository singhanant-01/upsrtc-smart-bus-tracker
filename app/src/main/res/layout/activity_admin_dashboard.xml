<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_dashboard"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assign_bus_to_driver"
            android:textSize="17sp"
            android:textColor="#555555"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/driverUidInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/driver_firebase_uid"
            android:inputType="text"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/busNumberInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/bus_registration_hint"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/routeIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/route_id"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/servicePatternInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/service_pattern_id"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/directionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/direction"
            android:text="@string/gorakhpur_to_lucknow"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/assignBusButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assign_bus"
            android:layout_marginTop="24dp"/>

        <Button
            android:id="@+id/adminLogoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>
