<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DriverActivity">

    <TextView
        android:id="@+id/driverDashboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/driver_dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/welcomeDriver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_driver"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/driverDashboardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/busRegistrationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bus_registration"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeDriver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Spinner
        android:id="@+id/routeSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:prompt="@string/choose_assigned_bus"
        app:layout_constraintTop_toBottomOf="@id/busRegistrationLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/busNumberInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:inputType="textCapCharacters"
        app:layout_constraintTop_toBottomOf="@id/routeSpinner"
        app:layout_constraintStart_toStartOf="@id/routeSpinner"
        app:layout_constraintEnd_toEndOf="@id/routeSpinner"/>

    <TextView
        android:id="@+id/assignedRouteText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/routeSpinner"
        app:layout_constraintStart_toStartOf="@id/routeSpinner"
        app:layout_constraintEnd_toEndOf="@id/routeSpinner"/>

    <Button
        android:id="@+id/confirmAssignmentButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/confirm_assignment"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/assignedRouteText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/startTripButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/start_trip"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/confirmAssignmentButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/activeRouteText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/startTripButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/activeBusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/activeRouteText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
